# Salin file ini menjadi .env lalu isi nilainya (JANGAN commit file .env)

# Connection string dari Neon (Dashboard Neon -> Connection Details)
# Contoh: postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# String acak panjang untuk menandatangani token login.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Domain game di Vercel (boleh lebih dari satu, pisahkan koma). Kosong = semua origin boleh (hanya untuk dev).
# Contoh: https://undead-zombie.vercel.app
CLIENT_ORIGIN=

# Port server (hosting biasanya mengisi PORT otomatis)
PORT=3001
